<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;</TargetFrameworks>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    
    <!-- NuGet Package Metadata -->
    <PackageId>OpenCvSharp5.runtime.wasm</PackageId>
    <Title>OpenCvSharp native bindings for Wasm</Title>
    <Authors>shimat,vladkol</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/shimat/opencvsharp</PackageProjectUrl>
    <PackageIcon>opencvsharp.png</PackageIcon>
    <Description>Internal implementation package for OpenCvSharp to work on Wasm</Description>
    <PackageTags>Image Processing OpenCV Wrapper FFI opencvsharp wasm</PackageTags>
    <Copyright>Copyright 2008-2026</Copyright>
    <PackageReleaseNotes></PackageReleaseNotes>
    <RepositoryUrl>https://github.com/shimat/opencvsharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.runtime.md</PackageReadmeFile>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Declare the minimum compatible framework for this native-only package. -->
    <None Include="wasm-net8/_._" Pack="true" PackagePath="lib/net8.0" />
    <None Include="OpenCvSharp5.runtime.wasm.props" Pack="true" PackagePath="build/net8.0" />
    <None Include="wasm-net11/OpenCvSharp5.runtime.wasm.props" Pack="true" PackagePath="build/net11.0" />
    <None Include="../../runtimes/browser-wasm/3.1.56/OpenCvSharpExtern.a" Pack="true" PackagePath="runtimes/browser-wasm/3.1.56" />
    <None Include="../../runtimes/browser-wasm/6.0.2/OpenCvSharpExtern.a" Pack="true" PackagePath="runtimes/browser-wasm/6.0.2" />
    <None Include="icon/opencvsharp.png" Pack="true" PackagePath="" />
    <None Include="README.runtime.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
