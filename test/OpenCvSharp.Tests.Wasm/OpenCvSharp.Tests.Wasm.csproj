<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>CA1303;CA2007</NoWarn>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' != 'net8.0'">true</RunAOTCompilation>

    <!-- The default 32MB wasm heap is too small to even link the real OpenCV wasm binary. -->
    <WasmInitialHeapSize>268435456</WasmInitialHeapSize>
    <EmccInitialHeapSize Condition="'$(TargetFramework)' == 'net8.0'">$(WasmInitialHeapSize)</EmccInitialHeapSize>

    <WasmAllowUndefinedSymbols>false</WasmAllowUndefinedSymbols>

    <!-- Older workloads bundle Binaryen versions with fewer optimization flags. -->
    <EmccLinkOptimizationFlag Condition="'$(TargetFramework)' != 'net11.0'">-O1</EmccLinkOptimizationFlag>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.34" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.34" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp5" Version="$(OpenCvSharpPackageVersion)" />
    <PackageReference Include="OpenCvSharp5.runtime.wasm" Version="$(OpenCvSharpPackageVersion)" />
  </ItemGroup>

  <!-- Keep OpenCvSharp available for type resolution while avoiding the Mono AOT assertion
       in opencvsharp_blazor_sample#8. This matches the sample's partial AOT configuration. -->
  <Target Name="MarkOpenCvSharpForInterpretation" BeforeTargets="_WasmAotCompileApp">
    <ItemGroup>
      <_WasmAssembliesInternal Condition="'%(_WasmAssembliesInternal.FileName)' == 'OpenCvSharp'" AOT_InternalForceToInterpret="true" />
    </ItemGroup>
  </Target>

</Project>
